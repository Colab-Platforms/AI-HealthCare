{
  "version": 2,
  "buildCommand": "cd client && npm ci --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --production=false && cd server && npm install --production=false",
  "devCommand": "cd client && npm run dev",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/spa.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!r/|api/public/shares/|api/shop/checkout/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.gstatic.com https://connect.facebook.net https://static.ads-twitter.com https://ads-twitter.com https://ads-api.twitter.com https://analytics.twitter.com https://*.clarity.ms https://accounts.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://vercel.live https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com https://checkout.razorpay.com; font-src 'self' https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://ai-healthcare-ip89.onrender.com https://www.google-analytics.com https://analytics.google.com https://www.google.com https://www.facebook.com https://connect.facebook.net https://static.ads-twitter.com https://ads-twitter.com https://ads-api.twitter.com https://analytics.twitter.com https://*.clarity.ms https://googleads.g.doubleclick.net https://www.googleadservices.com https://ad.doubleclick.net https://tse1.mm.bing.net https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.cdnfonts.com https://api.razorpay.com https://lumberjack.razorpay.com https://checkout.razorpay.com https://cdn.shopify.com https://res.cloudinary.com; frame-src 'self' blob: https://accounts.google.com https://vercel.live https://api.razorpay.com https://checkout.razorpay.com https://cdn.shopify.com https://res.cloudinary.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/(r|api/public/shares)/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/shop/checkout/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/register",
      "destination": "/waitlist",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    { "source": "/login", "destination": "/spa.html" },
    { "source": "/forgot-password", "destination": "/spa.html" },
    { "source": "/dashboard", "destination": "/spa.html" },
    { "source": "/upload", "destination": "/spa.html" },
    { "source": "/reports", "destination": "/spa.html" },
    { "source": "/reports/:id", "destination": "/spa.html" },
    { "source": "/reports/:id/summary", "destination": "/spa.html" },
    { "source": "/report/:id", "destination": "/spa.html" },
    { "source": "/challenge", "destination": "/spa.html" },
    { "source": "/nutrition", "destination": "/spa.html" },
    { "source": "/fitness", "destination": "/spa.html" },
    { "source": "/glucose-log", "destination": "/spa.html" },
    { "source": "/vital-signs", "destination": "/spa.html" },
    { "source": "/medical-vault", "destination": "/spa.html" },
    { "source": "/medical-vault/:path*", "destination": "/spa.html" },
    { "source": "/supplements", "destination": "/spa.html" },
    { "source": "/subscription", "destination": "/spa.html" },
    { "source": "/shop", "destination": "/spa.html" },
    { "source": "/diet-plan", "destination": "/spa.html" },
    { "source": "/complete-analysis", "destination": "/spa.html" },
    { "source": "/log-vitals/:metric", "destination": "/spa.html" },
    { "source": "/step-tracker", "destination": "/spa.html" },
    { "source": "/smoke-tracker", "destination": "/spa.html" },
    { "source": "/alcohol-tracker", "destination": "/spa.html" },
    { "source": "/ai-chat", "destination": "/spa.html" },
    { "source": "/food-safety", "destination": "/spa.html" },
    { "source": "/profile", "destination": "/spa.html" },
    { "source": "/notification-settings", "destination": "/spa.html" },
    { "source": "/privacy-settings", "destination": "/spa.html" },
    { "source": "/onboarding", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" },
    { "source": "/doctor", "destination": "/spa.html" },
    { "source": "/doctor/:path*", "destination": "/spa.html" }
  ]
}
