PORT=5000
MONGODB_URI=mongodb://localhost:27017/healthcare-ai
JWT_SECRET=your-super-secret-jwt-key-change-in-production
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Sign-In (from Google Cloud Console > APIs & Services > Credentials)
# Comma-separated if you have multiple client IDs (Web, iOS, Android each get their own)
GOOGLE_CLIENT_ID=your-web-client-id,your-ios-client-id,your-android-client-id
APP_URL=http://localhost:3000
NODE_ENV=development

# MSG91 (phone login + phone number verification via SMS OTP)
# template_id must be a DLT-approved SMS template with an {{OTP}} variable
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-6-char-dlt-sender-id
MSG91_OTP_TEMPLATE_ID=your-dlt-approved-template-id

# Feature flags (alcohol tracker API enabled unless explicitly false)
# ENABLE_ALCOHOL_TRACKER=false

# Razorpay (subscription billing)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Shopify (dedicated catalog/backend store — see docs/shopify-mern-integration-plan.md)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-access-token

# Shopify card offer — store buyers get a 30-day free trial (services/shopifyOfferService.js).
# Set on EVERY backend (Vercel and Render). Admin token: read_orders (+ read_all_orders) only.
SHOPIFY_ADMIN_STORE_DOMAIN=     # the retail store the cards come from — NOT SHOPIFY_STORE_DOMAIN (Fastrr store)
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=         # signing key from Admin > Settings > Notifications > Webhooks
SHOPIFY_CLIENT_SECRET=          # app client secret — used instead if webhooks were created by the app
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ORDER_PREFIX=TAKE       # order names look like TAKE11005
SHOPIFY_OFFER_DAYS=30
SHOPIFY_OFFER_PRODUCT_IDS=      # Shopify product IDs with the offer (needs read_products); covers every variant, survives renames
SHOPIFY_OFFER_SKUS=             # backup: SKUs, or "TITLE:<product title>" for lines without SKU; both empty = every product
SHOPIFY_OFFER_STATUSES=paid,partially_refunded   # add "pending" to include unpaid COD orders
SHOPIFY_ALLOW_TEST_ORDERS=false # true only on staging
OFFER_MATCH_SECRET=             # long random string; never change it after go-live

# Headless shop (server/modules/shop, /api/shop) — see docs/shop-headless-plan.md.
# Set on EVERY backend (Vercel and Render).
SHOP_MAX_QTY_PER_ITEM=10       # shop cart: max quantity of one item
SHOP_MAX_CART_LINES=30         # shop cart: max different items
SHOP_HIDE_SUBSCRIBE_VARIANTS=true  # hide "Subscribe" variants (no recurring billing in our checkout)
SHOP_PUBLIC_BASE_URL=https://www.take.health   # origin the WebView + Fastrr use for /api/shop/checkout/* links
SHOP_APP_DEEP_LINK=takehealth://shop/order/{orderId}?status={status}   # where the WebView returns the user
SHOP_CHECKOUT_PAGE_SECRET=     # optional; signs checkout-page links (derived from JWT_SECRET if empty)
SHOP_CHECKOUT_PAGE_TTL_MIN=120 # signed checkout-page link lifetime
SHOP_PLACEHOLDER_IMAGE_URL=    # image sent to Fastrr for items without one

# Fastrr / Shiprocket Checkout. Catalog pull (/api/shop/fastrr/*) works without
# these; checkout, the order webhook, reconciliation and catalog push need them.
# Staging API https://fastrr-api-dev.pickrr.com · prod https://checkout-api.shiprocket.com
FASTRR_BASE_URL=https://fastrr-api-dev.pickrr.com
FASTRR_API_KEY=
FASTRR_API_SECRET=
FASTRR_TIMEOUT_MS=10000
FASTRR_CHECKOUT_UI_URL=        # optional; JS checkout bundle origin (auto: staging bundle for the staging API)
FASTRR_FALLBACK_URL=           # optional; default = our own /checkout/:id/return page (keeps users off the Shopify site)
FASTRR_CATALOG_PUSH=true       # push product/collection changes to Fastrr after Shopify webhooks

# Shop M3 — Shopify order creation (needs write_orders on SHOPIFY_ADMIN_TOKEN).
SHOP_SHOPIFY_ORDER_SYNC=false  # keep false until Fastrr confirms it does NOT create Shopify orders itself
SHOP_SHOPIFY_TEST_ORDERS=false # true only while testing on the live store (orders marked as Shopify test orders)
SHOP_SHOPIFY_SEND_RECEIPT=false # Shopify's own customer emails (the app sends push instead)
SHOP_SHOPIFY_SYNC_MAX_ATTEMPTS=5
SHOP_APP_ORDERS_CARD_OFFER=true # app orders also count for the card offer (management decision)
SHOP_ORDER_PUSH=true           # push on order confirmed / shipped / delivered / cancelled
SHOP_RESERVATION_MINUTES=15    # stock hold while the user starts paying (then tied to the Fastrr token)
