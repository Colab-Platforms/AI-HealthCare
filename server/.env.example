PORT=5000
MONGODB_URI=mongodb://localhost:27017/healthcare-ai
JWT_SECRET=your-super-secret-jwt-key-change-in-production
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Sign-In (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
APP_URL=http://localhost:3000
NODE_ENV=development

# Feature flags (alcohol tracker API enabled unless explicitly false)
# ENABLE_ALCOHOL_TRACKER=false

# Razorpay (subscription billing)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Shopify (dedicated catalog/backend store — see docs/shopify-mern-integration-plan.md)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-access-token

# Fastrr / Shiprocket Checkout (see docs/fastrr-shiprocket-checkout-integration-plan.md)
# Not yet received from Fastrr team — /shiprocket/products and /shiprocket/collections
# work without these; /api/checkout/start and the webhook receiver need them.
FASTRR_BASE_URL=https://fastrr-api-dev.pickrr.com
FASTRR_API_KEY=
FASTRR_API_SECRET=
