# API Configuration
# For local development with mobile access:
# Leave this empty or comment it out - the app will auto-detect the server URL
# VITE_API_URL=

# For production or specific server:
# VITE_API_URL=https://api.yourdomain.com/api

# For local development with specific IP:
# VITE_API_URL=http://192.168.x.x:5000/api

# Feature flags
# Set to false to hide alcohol tracker UI
# VITE_ENABLE_ALCOHOL_TRACKER=true

# Google Sign-In (same Client ID as server's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
